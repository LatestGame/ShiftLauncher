{
  "name": "kivra-launcher",
  "productName": "Kivra Launcher",
  "version": "0.1.0",
  "description": "Лёгкий лаунчер Minecraft без рекламы и телеметрии: моды из Modrinth и CurseForge, P2P-друзья, звонки, видео и ИИ",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "node scripts/copy-font.js && electron .",
    "test": "node test/run.js && node test/ui-smoke.js",
    "dist": "node scripts/copy-font.js && electron-builder",
    "dist:win": "node scripts/copy-font.js && electron-builder --win",
    "dist:linux": "node scripts/copy-font.js && electron-builder --linux AppImage deb tar.gz zip",
    "dist:linux-zip": "node scripts/copy-font.js && electron-builder --linux zip",
    "dist:mac": "node scripts/copy-font.js && electron-builder --mac dmg zip"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "@fontsource-variable/inter": "^5.1.0"
  },
  "build": {
    "appId": "local.kivra.launcher",
    "productName": "Kivra Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "KivraLauncher-Setup-${version}.${ext}",
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true,
      "perMachine": true
    },
    "portable": {
      "artifactName": "KivraLauncher-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        { "target": "zip", "arch": ["x64"] },
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] },
        { "target": "tar.gz", "arch": ["x64"] }
      ],
      "category": "Game",
      "executableName": "kivra-launcher",
      "artifactName": "KivraLauncher-Linux-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "category": "public.app-category.games",
      "artifactName": "KivraLauncher-macOS-${version}-${arch}.${ext}"
    }
  }
}
